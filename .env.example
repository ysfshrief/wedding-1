# Neon Postgres connection string (Neon dashboard → Connection string)
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Admin panel password (server-only). Defaults to 00000 when unset.
ADMIN_PASSWORD=change-me

# Optional: secret used to sign admin session cookies
ADMIN_SESSION_SECRET=

# Public site URL (used for SEO / share previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
