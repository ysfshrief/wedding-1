rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings: readable by anyone, writable (admin protected via app password)
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Gallery: public read; write from admin panel
    match /gallery/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Guest messages: anyone can create (pending); read only approved handled in queries
    match /messages/{doc} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if true;
    }

    // Video / drive links: anyone can create (pending)
    match /videos/{doc} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if true;
    }

    // Visits counter
    match /visits/{doc} {
      allow read: if true;
      allow write: if true;
    }
  }
}
